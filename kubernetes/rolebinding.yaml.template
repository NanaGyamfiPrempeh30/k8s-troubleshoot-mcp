# REQ-011: RoleBinding template. Substitute __NAMESPACE__ with each namespace
# the server is permitted to read, then apply:
#
#     sed 's/__NAMESPACE__/staging/g' kubernetes/rolebinding.yaml.template \
#       | kubectl apply -f -
#
# Apply one binding per namespace in ALLOWED_NAMESPACES. Both the Role and this
# RoleBinding must exist in a namespace before the server can read anything
# there — RBAC is the enforcement boundary, and a namespace listed in
# ALLOWED_NAMESPACES but never bound stays unreadable.
#
# Never substitute __NAMESPACE__ with kube-system or kube-public. The server
# strips both from ALLOWED_NAMESPACES at startup (REQ-008), so a binding there
# would grant access the server refuses to use — real permission with no
# corresponding capability, which is exactly the kind of drift an audit should
# not have to discover.
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: k8s-mcp-readonly
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: k8s-troubleshoot-mcp
    app.kubernetes.io/component: rbac
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: k8s-mcp-readonly
subjects:
  - kind: ServiceAccount
    name: k8s-mcp-server
    namespace: k8s-mcp
